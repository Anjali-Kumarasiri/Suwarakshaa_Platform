# Usage: docker build -f Dockerfile.template --build-arg PROJECT=Api -t core-api .
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
ARG PROJECT
WORKDIR /src
COPY src ./src
RUN dotnet publish src/${PROJECT}/${PROJECT}.csproj -c Release -o /app
FROM mcr.microsoft.com/dotnet/aspnet:8.0
ARG PROJECT
ENV PROJECT=${PROJECT}
WORKDIR /app
COPY --from=build /app .
ENTRYPOINT ["sh","-c","dotnet ${PROJECT}.dll"]
